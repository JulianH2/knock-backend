{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "python3 scripts/hooks/knock_guard.py pre-tool --tool cursor",
        "timeout": 90
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 scripts/hooks/knock_guard.py pre-tool --tool cursor",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "python3 scripts/hooks/knock_guard.py stop --tool cursor",
        "timeout": 900,
        "loop_limit": 3
      }
    ]
  }
}
