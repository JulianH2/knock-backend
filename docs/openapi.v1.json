  "components": {
    "schemas": {
      "BusquedaInterpretacion": {
        "required": [
          "estado",
          "oficioDetectado",
          "oficiosSugeridos"
        ],
        "type": "object",
        "properties": {
          "estado": {
            "type": "string"
          },
          "oficioDetectado": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/BusquedaOficio"
              }
            ]
          },
          "oficiosSugeridos": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/BusquedaOficio"
            }
          }
        }
      },
      "BusquedaItem": {
        "required": [
          "id",
          "nombre",
          "oficios",
          "calificacion",
          "totalResenas",
          "verificado",
          "nivelVerificacion",
          "coloniaBase",
          "distanciaKm",
          "atiendeTuColonia",
          "fotoUrl"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "oficios": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BusquedaOficio"
            }
          },
          "calificacion": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "totalResenas": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "verificado": {
            "type": "boolean"
          },
          "nivelVerificacion": {
            "type": "string"
          },
          "coloniaBase": {
            "type": [
              "null",
              "string"
            ]
          },
          "distanciaKm": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "atiendeTuColonia": {
            "type": "boolean"
          },
          "fotoUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "BusquedaOficio": {
        "required": [
          "clave",
          "nombre"
        ],
        "type": "object",
        "properties": {
          "clave": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          }
        }
      },
      "BusquedaResponse": {
        "required": [
          "interpretacion",
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "interpretacion": {
            "$ref": "#/components/schemas/BusquedaInterpretacion"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BusquedaItem"
            }
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "NeighborhoodAtPointColoniaResponse": {
        "required": [
          "id",
          "nombre",
          "cp",
