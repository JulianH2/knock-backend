{
  "threshold": 3,
  "minLines": 12,
  "minTokens": 70,
  "reporters": ["console", "markdown"],
  "output": "reports/jscpd",
  "format": ["csharp", "sql", "javascript", "yaml"],
  "ignore": ["**/bin/**", "**/obj/**", "**/Migrations/**", "**/node_modules/**", "**/reports/**", "**/StrykerOutput/**",
             "docs/**", ".claude/**", ".opencode/**", ".github/agents/**", ".github/instructions/**", ".cursor/**", "**/Fixtures/**"],
  "absolute": false,
  "exitCode": 1
}
