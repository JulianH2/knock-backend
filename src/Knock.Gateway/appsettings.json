{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "knock-api",
    "Audience": "knock-app"
  },
  "PanelJwt": {
    "Audience": "knock-panel"
  },
  "Cors": {
    "Panel": {
      "Origen": ""
    }
  },
  "Security": {
    "Cors": {
      "AllowedOrigins": []
    }
  },
  "RateLimiting": {
    "Ip": { "PermitLimit": 100, "Window": "00:01:00" },
    "Auth": { "PermitLimit": 10, "Window": "00:01:00" },
    "User": { "PermitLimit": 120, "Window": "00:01:00" },
    "Search": { "PermitLimit": 30, "Window": "00:01:00" },
    "Discard": { "PermitLimit": 30, "Window": "01:00:00" }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Observability": {
    "ServiceName": "knock-gateway",
    "SamplingRatio": 1.0,
    "EnableLiveMetrics": false
  },
  "ReverseProxy": {
    "Routes": {
      "identidad-sesion-firebase": { "ClusterId": "identidad", "AuthorizationPolicy": "anonymous", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/auth/firebase" } },
      "identidad-sesion-renovacion": { "ClusterId": "identidad", "AuthorizationPolicy": "anonymous", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/auth/refresh" } },
      "identidad-sesion": { "ClusterId": "identidad", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/auth/{**resto}" } },
      "panel-sesion-cerrar": { "ClusterId": "identidad", "AuthorizationPolicy": "panel", "CorsPolicy": "panel", "Match": { "Path": "/api/v1/panel/sesion/cerrar" } },
      "panel-sesion": { "ClusterId": "identidad", "AuthorizationPolicy": "anonymous", "CorsPolicy": "panel", "Match": { "Path": "/api/v1/panel/sesion/{**resto}" } },
      "panel-activacion": { "ClusterId": "identidad", "AuthorizationPolicy": "anonymous", "CorsPolicy": "panel", "Match": { "Path": "/api/v1/panel/activacion" } },
      "panel-resto": { "ClusterId": "identidad", "AuthorizationPolicy": "panel", "CorsPolicy": "panel", "Match": { "Path": "/api/v1/panel/{**resto}" } },
      "identidad-recuperacion-acceso": { "ClusterId": "identidad", "AuthorizationPolicy": "anonymous", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/recuperacion-acceso" } },
      "identidad-perfil": { "ClusterId": "identidad", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/me/{**resto}" } },
      "identidad-bloqueo": {
      "ClusterId": "identidad",
      "AuthorizationPolicy": "default",
      "CorsPolicy": "knock",
      "Match": { "Path": "/api/v1/usuarios/{id}/bloqueo" }
    },
    "identidad-reportes": {
      "ClusterId": "identidad",
      "AuthorizationPolicy": "default",
      "CorsPolicy": "knock",
      "Match": { "Path": "/api/v1/reportes/{**resto}" }
    },
    "mercado-oficios": { "ClusterId": "mercado", "AuthorizationPolicy": "anonymous", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/oficios/{**resto}" } },
      "mercado-colonias": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/colonias/{**resto}" } },
      "mercado-lista-espera": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/zonas/lista-espera" } },
      "mercado-zonas-cp": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/zonas/cp/{**resto}" } },
      "mercado-confianza": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/me/tecnicos-confianza/{**resto}" } },
      "mercado-busqueda": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/busqueda" } },
      "mercado-solicitudes": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/solicitudes" } },
      "mercado-solicitud": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/solicitudes/{id}" } },
      "mercado-solicitud-elegir": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/solicitudes/{id}/elegir" } },
      "mercado-solicitud-descartar": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/solicitudes/{id}/descartar", "Methods": [ "POST" ] } },
      "mercado-visita": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/visitas/{id}" } },
      "mercado-visita-llegada": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/visitas/{id}/llegada" } },
      "mercado-visita-aviso": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/visitas/{id}/aviso" } },
      "mercado-tecnicos": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/tecnicos", "Methods": [ "POST" ] } },
      "mercado-tecnico-me": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/tecnicos/me", "Methods": [ "PUT" ] } },
      "mercado-tecnico-me-cotizaciones": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/tecnicos/me/cotizaciones", "Methods": [ "GET" ] } },
      "mercado-tecnico-trabajo": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/tecnicos/me/trabajo", "Methods": [ "GET" ] } },
      "mercado-tecnico-solicitudes": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/tecnicos/me/solicitudes", "Methods": [ "GET" ] } },
      "mercado-tecnico-me-disponibilidad": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/tecnicos/me/disponibilidad", "Methods": [ "PUT" ] } },
      "mercado-tecnico-me-horarios": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/tecnicos/me/horarios", "Methods": [ "GET", "PUT" ] } },
      "mercado-tecnicos-autocompletar": { "ClusterId": "mercado", "AuthorizationPolicy": "anonymous", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/tecnicos/autocompletar", "Methods": [ "GET" ] } },
      "mercado-tecnico-llega": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/tecnicos/{id}/llega-a-mi-colonia", "Methods": [ "GET" ] } },
      "mercado-tecnico": { "ClusterId": "mercado", "AuthorizationPolicy": "anonymous", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/tecnicos/{id}", "Methods": [ "GET" ] } },
      "mercado-cotizaciones": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/solicitudes/{id}/cotizaciones" } },
      "mensajeria-hub": {
      "ClusterId": "mensajeria",
      "AuthorizationPolicy": "default",
      "CorsPolicy": "knock",
      "Match": { "Path": "/hubs/chat/{**resto}" }
    },
    "mensajeria-mensajes": { "ClusterId": "mensajeria", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/mensajes/{**resto}" } },
      "mensajeria-notificaciones": { "ClusterId": "mensajeria", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/notificaciones/{**resto}" } }
    },
    "Clusters": {
      "identidad": { "Destinations": { "principal": { "Address": "http://localhost:5062/" } } },
      "mercado": { "Destinations": { "principal": { "Address": "http://localhost:5234/" } } },
      "mensajeria": { "Destinations": { "principal": { "Address": "http://localhost:5226/" } } }
    }
  },
  "Redis": {
    "Database": 0,
    "ConnectTimeoutSeconds": 5,
    "SyncTimeoutSeconds": 5
  }
}
