{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "Window": "00:01:00"
    },
    "Auth": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    }
  },
  "Jwt": {
    "Issuer": "knock-api",
    "Audience": "knock-app"
  },
  "Firebase": {
    "ProjectId": "knock-0"
  }
}
