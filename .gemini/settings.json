{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/knock_guard.py\" session-start --tool gemini"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "write_file|replace|edit|run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/knock_guard.py\" pre-tool --tool gemini"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/knock_guard.py\" stop --tool gemini"
          }
        ]
      }
    ]
  }
}
